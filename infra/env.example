# 占位：后续补充环境变量示例`n

# Cloudflare Turnstile 人机验证
# 本地默认值使用 Cloudflare 官方测试密钥；生产环境必须替换为真实 sitekey/secret。
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
LABELHUB_AUTH_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
LABELHUB_AUTH_TURNSTILE_SITEVERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
LABELHUB_AUTH_TURNSTILE_TIMEOUT_MS=5000

# Agent 机器登录绕过浏览器人机验证的共享服务令牌。
# 生产环境必须替换为强随机值，并确保后端和 Agent 两侧一致。
LABELHUB_AUTH_SERVICE_LOGIN_TOKEN=labelhub-local-service-login-token
LABELHUB_AGENT_SERVICE_LOGIN_TOKEN=labelhub-local-service-login-token
