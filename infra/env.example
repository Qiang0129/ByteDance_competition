LABELHUB_IMAGE_TAG=0.1.0
LABELHUB_BACKEND_IMAGE=docker.io/your-dockerhub-user/labelhub-backend:0.1.0
LABELHUB_AGENT_IMAGE=docker.io/your-dockerhub-user/labelhub-agent:0.1.0
LABELHUB_FRONTEND_IMAGE=docker.io/your-dockerhub-user/labelhub-frontend:0.1.0

LABELHUB_BACKEND_HOST_PORT=8080
LABELHUB_FRONTEND_HOST_PORT=18080

LABELHUB_MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
LABELHUB_DB_USERNAME=labelhub
LABELHUB_DB_PASSWORD=replace-with-strong-db-password
LABELHUB_REDIS_PASSWORD=replace-with-strong-redis-password

LABELHUB_AUTH_TOKEN_TTL_SECONDS=7200
LABELHUB_AUTH_CORS_ALLOWED_ORIGIN_PATTERNS=https://www.scu-gpt.top
LABELHUB_AUTH_TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret-key
LABELHUB_AUTH_TURNSTILE_SITEVERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
LABELHUB_AUTH_TURNSTILE_TIMEOUT_MS=5000
LABELHUB_AUTH_SERVICE_LOGIN_TOKEN=replace-with-shared-strong-service-token

LABELHUB_DEMO_USERS_ENABLED=false
LABELHUB_INITIAL_OWNER_ENABLED=true
LABELHUB_INITIAL_OWNER_USERNAME=labelhub_owner
LABELHUB_INITIAL_OWNER_DISPLAY_NAME=LabelHub Owner
LABELHUB_INITIAL_OWNER_PASSWORD=replace-with-strong-owner-password

LABELHUB_SYSTEM_AGENT_ENABLED=true
LABELHUB_SYSTEM_AGENT_USERNAME=system_agent
LABELHUB_SYSTEM_AGENT_DISPLAY_NAME=System Agent
LABELHUB_SYSTEM_AGENT_PASSWORD=replace-with-strong-agent-password

LABELHUB_MODEL_CONFIG_SECRET=replace-with-stable-32-byte-or-longer-secret

LABELHUB_AGENT_WORKER_ENABLED=true
LABELHUB_AGENT_CONCURRENCY=1
LABELHUB_AGENT_POLL_INTERVAL_MS=5000
LABELHUB_AGENT_IDLE_DELAY_MS=1500
LABELHUB_LLM_BASE_URL=https://your-openai-compatible-provider/v1
LABELHUB_LLM_API_KEY=replace-with-llm-api-key
LABELHUB_LLM_MODEL=replace-with-model-name
LABELHUB_LLM_REASONING_EFFORT=high
LABELHUB_LLM_WIRE_API=responses
LABELHUB_LLM_TIMEOUT_MS=120000

LABELHUB_BACKEND_JAVA_OPTS=-Xms128m -Xmx512m -XX:+ExitOnOutOfMemoryError
LABELHUB_AGENT_JAVA_OPTS=-Xms96m -Xmx384m -XX:+ExitOnOutOfMemoryError

VITE_APP_BASE_PATH=/labelhub/
VITE_API_BASE_URL=/labelhub/api
VITE_TURNSTILE_SITE_KEY=replace-with-cloudflare-turnstile-site-key
VITE_DEMO_VIDEO_URL=
